---
import Base from "../../layouts/Base.astro";
import TagPill from "../../components/TagPill.astro";
import { getPosts, allTags, type Post } from "../../lib/posts";
import { formatPostDay } from "../../lib/dates";
import { tagColor } from "../../lib/tags";

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...allTags(posts).keys()].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`tag: ${tag}`} description={`Posts tagged ${tag}.`}>
  <h1 class="page-title">
    tags/<span style={`color: ${tagColor(tag!)}`}>{tag}</span>
  </h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <span class="when">{formatPostDay(p.data.date)}</span>
          <a href={`/posts/${p.id}/`}>{p.data.title}</a>
          <span class="dots" />
          <span class="mini-tags">
            {p.data.tags
              .filter((t) => t !== tag)
              .slice(0, 3)
              .map((t) => (
                <TagPill tag={t} />
              ))}
          </span>
        </li>
      ))
    }
  </ul>
</Base>
