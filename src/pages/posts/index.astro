---
import Base from "#src/layouts/Base.astro";
import TagPill from "#src/components/TagPill.astro";
import { getPosts } from "#src/lib/posts";
import { formatPostDay } from "#src/lib/dates";

const posts = await getPosts();
const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const y = p.data.date.slice(0, 4);
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---

<Base title="posts" description="All posts, newest first.">
  <h1 class="page-title">posts</h1>
  {
    [...byYear.entries()].map(([year, group]) => (
      <>
        <h2 class="year-h">── {year} ──</h2>
        <ul class="post-list">
          {group.map((p) => (
            <li>
              <span class="when">{formatPostDay(p.data.date)}</span>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <span class="dots" />
              <span class="mini-tags">
                {p.data.tags.slice(0, 3).map((t) => (
                  <TagPill tag={t} />
                ))}
              </span>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Base>
