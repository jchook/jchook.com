---
import { render } from "astro:content";
import Base from "#src/layouts/Base.astro";
import PostHeader from "#src/components/PostHeader.astro";
import Pager from "#src/components/Pager.astro";
import Sidebar from "#src/components/Sidebar.astro";
import { getPosts, neighborsOf, relatedTo, type Post } from "#src/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const posts = await getPosts();
const { Content } = await render(post);
const neighbors = neighborsOf(posts, post);
---

<Base title={post.data.title} description={post.data.description}>
  <div class="two-col">
    <article data-pagefind-body>
      <PostHeader post={post} />
      <div class="prose">
        <Content />
      </div>
      <Pager newer={neighbors.newer} older={neighbors.older} />
    </article>
    <Sidebar neighbors={neighbors} related={relatedTo(posts, post)} />
  </div>
</Base>
