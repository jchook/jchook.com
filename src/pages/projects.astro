---
import Base from "#src/layouts/Base.astro";
import { tagColor } from "#src/lib/tags";

const sections = [
  {
    title: "flagships",
    projects: [
      {
        name: "Freed.ai",
        tag: "healthcare · ai",
        url: "https://www.freed.ai",
        desc: "An AI-first EHR with automatic SOAP note generation.",
      },
      {
        name: "Zinc.email",
        tag: "email · open source",
        url: "https://zinc.email",
        desc: "An open-source email proxy service.",
      },
      {
        name: "HelloPrivacy.com",
        tag: "privacy · infrastructure",
        url: "https://helloprivacy.com",
        desc: "Privacy infrastructure serving tens of millions of users through partners including Experian, Discover, and McAfee. I architected the API and scaled the infrastructure.",
      },
    ],
  },
  {
    title: "open source",
    projects: [
      {
        name: "ranger-zoxide",
        tag: "python",
        url: "https://github.com/jchook/ranger-zoxide",
        desc: "Jump between common directories in ranger with zoxide.",
      },
      {
        name: "shhh",
        tag: "rust",
        url: "https://github.com/jchook/shhh",
        desc: "Alerts you when you are too loud. A noise meter for your mic.",
      },
      {
        name: "rewait",
        tag: "javascript",
        url: "https://github.com/jchook/rewait",
        desc: "Wait for resources to become available — HTTP, TCP, sockets, files, or custom functions.",
      },
      {
        name: "hngram",
        tag: "rust",
        url: "https://github.com/jchook/hngram",
        desc: "Hacker News n-gram viewer.",
      },
      {
        name: "caption-tui",
        tag: "typescript",
        url: "https://github.com/jchook/caption-tui",
        desc: "Terminal-based image dataset captioning tool.",
      },
    ],
  },
  {
    title: "forks",
    projects: [
      {
        name: "SCFusion",
        tag: "c++",
        url: "https://github.com/jchook/SCFusion",
        desc: "Ported this StarCraft II genetic build-order generator from Windows to macOS and Linux, and updated it for the latest game patches.",
      },
      {
        name: "void-packages",
        tag: "shell",
        url: "https://github.com/jchook/void-packages",
        desc: "My contributions to the Void Linux package collection, where I maintain a small set of packages.",
      },
      {
        name: "qs",
        tag: "javascript",
        url: "https://github.com/jchook/qs",
        desc: "Added support for leaving selected RFC-permitted characters unescaped, producing clean query strings like ?list=a,b,c,d.",
      },
    ],
  },
  {
    title: "legacy",
    projects: [
      {
        name: "CowFight.com",
        tag: "security · hacking",
        url: "https://cowfight.com",
        desc: "A security and hacking team active from 1998 to 2004.",
      },
    ],
  },
];
---

<Base title="projects" description="Selected products and open-source work by Wes Roberts.">
  <h1 class="page-title">projects</h1>
  <div class="project-sections">
    {
      sections.map((section) => (
        <section class="project-section" aria-labelledby={`section-${section.title.replace(" ", "-")}`}>
          <h2 id={`section-${section.title.replace(" ", "-")}`}>{section.title}</h2>
          <ul class="proj-grid">
            {section.projects.map((project) => (
              <li class="proj" style={`--pc: ${tagColor(project.tag)}`}>
                <a href={project.url}>
                  <span class="proj-name">{project.name}</span>
                  <span class="proj-desc">{project.desc}</span>
                  <span class="proj-tag">{project.tag}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .project-sections {
    display: grid;
    gap: 3.25rem;
  }
  .project-section h2 {
    margin: 0 0 1rem;
    color: var(--fg0);
    font-size: 1.25rem;
    font-stretch: 115%;
    font-weight: 900;
    letter-spacing: -0.02em;
    word-spacing: -0.35em;
  }
  .project-section h2::before {
    content: "./";
    margin-right: 0.35em;
    color: var(--yellow);
  }
  .proj-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .proj a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--bg2);
    border-left: 3px solid var(--pc);
    background: var(--bg1);
    color: var(--fg2);
  }
  .proj a:hover {
    text-decoration: none;
    border-color: var(--pc);
  }
  .proj-name {
    color: var(--fg0);
    font-weight: 800;
  }
  .proj-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    flex: 1;
  }
  .proj-tag {
    color: var(--pc);
    font-size: 0.78rem;
  }
</style>
